<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is intentionally OFF during pre-release dev builds.
         Reading SSH key files (~/.ssh/id_*) and saving sessions inside a
         sandboxed app requires security-scoped bookmarks plumbing that's
         out of scope for the v0.0.3 walking skeleton. Sandbox + bookmarks
         work re-enables in v1.0 alongside signing and notarization.
         See docs/POLICY.md "Threat model" and ROADMAP.md v1.0. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
